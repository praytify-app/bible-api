{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"], "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "One PR per package directory for routine minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["package.json"],
      "groupName": "gateway dependencies"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["portal/package.json"],
      "groupName": "portal dependencies"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["packages/**/package.json"],
      "groupName": "sdk and embed dependencies"
    },
    {
      "description": "Base images and GitHub Actions together, monthly",
      "matchManagers": ["dockerfile", "github-actions"],
      "schedule": ["before 6am on the first day of the month"],
      "groupName": "build infrastructure"
    }
  ]
}
