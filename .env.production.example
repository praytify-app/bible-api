# === Praytify Bible Production Environment ===
# Copy to .env.production locally or set these in the Dokploy compose
# environment section. Never commit real values.

# Postgres
POSTGRES_USER=bible
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=praytify_bible

# Gateway + engine share this. The host MUST be "bible-db" (the unique
# network alias), never "postgres" or localhost: the gateway also sits on
# the shared dokploy-network where another stack's "postgres" alias wins
# DNS resolution and the gateway silently connects to the wrong database.
DATABASE_URL=postgresql://bible:CHANGE_ME_STRONG_PASSWORD@bible-db:5432/praytify_bible

# BetterAuth
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
BETTER_AUTH_URL=https://api.praytify.bible
PORTAL_URL=https://praytify.bible

# GitHub OAuth (callback: https://api.praytify.bible/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (redirect: https://api.praytify.bible/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bible engine admin token
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Master API key for internal apps (bypasses per-key rate limits)
MASTER_API_KEY=CHANGE_ME_MASTER_KEY
