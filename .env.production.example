# Praytify Bible: production environment for docker-compose.prod.yml.
# Set these in the Dokploy compose environment. Never commit real values.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Shared by gateway and engine. The host MUST be "bible-db" (the unique
# network alias), never "postgres" or localhost: the gateway also sits on
# the shared dokploy-network, where another stack's "postgres" alias wins
# DNS and the gateway silently connects to the wrong database.
DATABASE_URL=postgresql://bible:CHANGE_ME_STRONG_PASSWORD@bible-db:5432/praytify_bible

# Gateway sessions
BETTER_AUTH_SECRET=CHANGE_ME_64_HEX_CHARS

# Gateway to engine trust. Same value is passed to both services.
GATEWAY_TOKEN=CHANGE_ME_64_HEX_CHARS

# Engine admin routes (internal network only)
ADMIN_TOKEN=CHANGE_ME_64_HEX_CHARS

# GitHub OAuth (callback: https://api.praytify.bible/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (redirect: https://api.praytify.bible/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: share rate-limit counters across gateway replicas.
REDIS_URL=

# Deprecated: remove once Praytify uses an internal-tier secret key
# (see docs/integrations/praytify.md).
MASTER_API_KEY=
