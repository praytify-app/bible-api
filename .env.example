# Praytify Bible gateway: local development.
# Copy to .env (gitignored). Every variable is validated at boot by src/config.ts.

NODE_ENV=development
PORT=3200
LOG_LEVEL=info

# Postgres. scripts/dev-stack.sh starts one on 55432 with this database.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/praytify_bible
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
MIGRATE_ON_BOOT=true

# The Bible engine (praytify-app/open-bible-api)
BIBLE_API_URL=http://127.0.0.1:3100
# Shared with the engine so it skips its own per-IP limiter for gateway traffic.
GATEWAY_TOKEN=dev-gateway-token-change-me
UPSTREAM_TIMEOUT_MS=15000
DOWNLOAD_TIMEOUT_MS=120000

# Public URLs
PUBLIC_API_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
# Comma-separated origins allowed to use the dashboard API with cookies.
PORTAL_URL=http://localhost:5173

# Sign-in. Use OAuth apps, email and password, or both.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
EMAIL_PASSWORD_AUTH=true
# GitHub callback: http://localhost:3200/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google redirect: http://localhost:3200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limits. Leave REDIS_URL empty for one gateway process; set it when
# running several so they share counters.
REDIS_URL=
ANON_RATE_PER_MINUTE=120
ANON_RATE_PER_DAY=20000
MAX_KEYS_PER_USER=20
KEY_CACHE_TTL_SECONDS=60
# Number of reverse proxies in front that append to X-Forwarded-For. 0 locally.
TRUST_PROXY_HOPS=0

# Read cache for scripture responses
READ_CACHE_MAX_MB=128
READ_CACHE_TTL_SECONDS=3600
READ_CACHE_MAX_ENTRY_KB=1024

# Background jobs (usage rollup, log purge). One replica runs each tick.
RUN_JOBS=true

# Deprecated. First-party apps should use an internal-tier secret key.
MASTER_API_KEY=
